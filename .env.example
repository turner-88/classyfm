# Copy to .env and adjust. The server also reads plain environment variables.

APP_ENV=development
HOST=0.0.0.0
PORT=8080

# MySQL DSN (leave empty to boot without a database during early phases)
# Example: classyfm:secret@tcp(127.0.0.1:3306)/classyfm?parseTime=true&charset=utf8mb4&loc=Local
# `make migrate-up`/`migrate-down` derive their golang-migrate URL from this same value,
# so there is no second connection string to keep in sync.
DATABASE_DSN=

# Session signing secret (change in production)
SESSION_SECRET=dev-insecure-secret-change-me

# Radio
STREAM_URL=https://c4.siar.us:10340/stream.mp3
# Shoutcast server base URL — now-playing metadata is scraped from its native
# /played.html and /stats?json=1 endpoints. Derived from STREAM_URL's host if unset.
SHOUTCAST_BASE_URL=https://c4.siar.us:10340
STATION_NAME=Classy 103.4 FM
STATION_SLOGAN=The Actual Radio - More Than Just Talk

# Public origin (no trailing slash) — used for canonical/OG URLs and sitemap.xml
SITE_URL=https://classyfm.remorac.com

# Google Analytics 4 property ID ("G-XXXXXXXXXX"). Leave blank to disable analytics —
# the public layout then emits no tag at all, so local dev doesn't report into the
# property. Only public pages are tracked; the admin panel never is.
GA_MEASUREMENT_ID=

# On-disk directory for user-uploaded files (e.g. program banner images), served
# at /uploads/*. Must be writable by the service user — see deploy/classyfm.service
# for the systemd ReadWritePaths= entry this requires in production.
UPLOAD_DIR=web/uploads

# Feed aggregation (Phase 4)
# YouTube uses the free RSS/Atom feed (no API key). Resolved channel ID for
# classyfm.co.id: UC7yseGthOK8sOtahtxvxDbg ("Classy 103.4 FM Padang")
YOUTUBE_CHANNEL_ID=
FEED_INTERVAL=30m

# How often the Shoutcast listener count is sampled, and how long the raw sample
# trail is kept. The per-day peak (what the dashboard charts) is kept forever.
LISTENER_INTERVAL=5m
LISTENER_RETENTION=720h

SHUTDOWN_TIMEOUT=10s

# SMTP (used to send "forgot password" reset emails). SMTP_PORT=587 uses STARTTLS
# (most providers); a provider requiring implicit TLS on port 465 isn't supported
# by the current stdlib-only net/smtp implementation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_TOKEN_TTL=1h
