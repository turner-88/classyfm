<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
{{.FontFaceCSS}}
:root {
  --navy: #292e62;
  --navy-dark: #14173a;
  --red: #e32229;
  --ink: #1f2333;
  --muted: #5a6072;
  --border: #d8dbe6;
  --code-bg: #f4f5fa;
  --zebra: #f7f8fc;
}
* { box-sizing: border-box; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body {
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  color: var(--ink);
  font-size: 10.5pt;
  line-height: 1.62;
  margin: 0;
}
h1, h2, h3, h4, h5, h6 {
  font-family: 'Outfit', system-ui, sans-serif;
  color: var(--navy);
  line-height: 1.2;
  font-weight: 700;
  margin: 1.5em 0 0.55em;
}
h1 { font-size: 24pt; margin-top: 0; letter-spacing: -0.01em; }
h2 {
  font-size: 16pt;
  margin-top: 1.7em;
  padding-bottom: 0.28em;
  border-bottom: 2px solid var(--red);
  break-before: page;
  break-after: avoid;
}
h3 { font-size: 12.5pt; color: var(--navy-dark); break-after: avoid; }
h4 { font-size: 11pt; color: var(--navy-dark); break-after: avoid; }
/* The first h2 sits right after the title block — don't force a blank first page. */
h2.no-break-before { break-before: auto; }
p { margin: 0.55em 0; }
a { color: var(--red); text-decoration: none; }
strong { font-weight: 700; color: var(--navy-dark); }
hr { border: 0; border-top: 1px solid var(--border); margin: 1.6em 0; }

code {
  font-family: 'Cascadia Mono', ui-monospace, monospace;
  font-size: 0.86em;
}
/* inline code */
:not(pre) > code {
  background: #fdeceb;
  color: #b4141b;
  padding: 0.08em 0.36em;
  border-radius: 4px;
  border: 1px solid #f6d6d5;
  white-space: nowrap;
}
pre, pre.hljs {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-left: 3px solid var(--navy);
  border-radius: 6px;
  padding: 0.85em 1em;
  overflow-x: auto;
  break-inside: avoid;
  margin: 0.9em 0;
}
pre code {
  background: none;
  border: 0;
  color: #24283b;
  padding: 0;
  white-space: pre;
  font-size: 8.6pt;
  line-height: 1.5;
}

table {
  border-collapse: collapse;
  width: 100%;
  margin: 1em 0;
  font-size: 9.3pt;
  break-inside: avoid;
}
thead { display: table-header-group; }
th, td {
  border: 1px solid var(--border);
  padding: 0.42em 0.7em;
  text-align: left;
  vertical-align: top;
}
th {
  background: var(--navy);
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-weight: 600;
  font-size: 9pt;
}
tbody tr:nth-child(even) { background: var(--zebra); }
td code, th code { white-space: normal; }

blockquote {
  margin: 1.1em 0;
  padding: 0.6em 1em;
  background: #f5f6fb;
  border-left: 4px solid var(--navy);
  border-radius: 0 6px 6px 0;
  color: var(--muted);
}
blockquote p { margin: 0.3em 0; }

ul, ol { padding-left: 1.4em; margin: 0.55em 0; }
li { margin: 0.2em 0; }

/* Cover / title block */
.cover {
  border-bottom: 3px solid var(--red);
  padding-bottom: 1.1em;
  margin-bottom: 0.2em;
  break-after: avoid;
}
.cover .eyebrow {
  font-family: 'Outfit', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 9pt;
  font-weight: 600;
  color: var(--red);
}
.station {
  font-family: 'Plus Jakarta Sans', sans-serif;
  color: var(--muted);
  font-size: 10pt;
  margin: 0.7em 0 1.4em;
}
</style>
</head>
<body>
<div class="cover"><div class="eyebrow">{{.Subtitle}}</div></div>
<div class="station">Generated {{.GeneratedDate}}</div>
{{.BodyHTML}}
</body>
</html>
